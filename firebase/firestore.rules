rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Papan peringkat: semua pemain login boleh membaca; hanya pemilik yang menulis datanya sendiri.
    match /players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.level is int
        && request.resource.data.totalEarned is int
        && request.resource.data.totalEarned >= 0
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
